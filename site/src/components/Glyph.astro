---
import { glyphFor } from './glyphs';
interface Props {
  name?: string;
  /** Draw on a graph-paper tile (cards, page titles). Off for inline use. */
  tile?: boolean;
  size?: 'sm' | 'md' | 'lg' | 'inline';
  class?: string;
}
const { name, tile = true, size = 'md', class: cls } = Astro.props;
const g = glyphFor(name);
---
{g && (
  <span class:list={['glyph', `glyph-${size}`, { 'glyph-tile': tile }, cls]} aria-hidden="true">
    <svg
      viewBox={g.viewBox ?? '0 0 32 32'}
      fill="none"
      stroke="currentColor"
      stroke-width={g.strokeWidth ?? 1.8}
      stroke-linejoin="round"
      stroke-linecap="round"
      set:html={g.svg}
    />
  </span>
)}
