---
/**
 * Search over every guide (titles, blurbs, headings and text) from /search.json.
 * Press "/" anywhere to jump into it. Results open on Enter or click.
 */
interface Props { size?: 'md' | 'lg'; placeholder?: string; autofocus?: boolean }
const { size = 'md', placeholder = 'Search the guide', autofocus = false } = Astro.props;
---
<div class:list={['search', { 'search-lg': size === 'lg' }]} data-search>
  <label class="search-field">
    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13 L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <span class="visually-hidden">Search the guide</span>
    <input type="search" placeholder={placeholder} autocomplete="off" spellcheck="false"
      role="combobox" aria-expanded="false" aria-autocomplete="list" autofocus={autofocus} />
    <kbd class="search-hint" aria-hidden="true">/</kbd>
  </label>
  <ul class="search-results" role="listbox" hidden></ul>
</div>

<script>
  type Entry = { slug: string; title: string; blurb: string; group: string; glyph: string; headings: { text: string; slug: string }[]; text: string };
  let index: Promise<Entry[]> | null = null;
  const load = () => (index ??= fetch('/search.json').then((r) => r.json()).catch(() => []));

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const fold = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '');

  function snippet(text: string, terms: string[]) {
    const f = fold(text);
    let at = -1;
    for (const t of terms) { at = f.indexOf(t); if (at >= 0) break; }
    if (at < 0) return '';
    const start = Math.max(0, text.lastIndexOf(' ', Math.max(0, at - 40)) + 1);
    let s = esc((start > 0 ? '…' : '') + text.slice(start, start + 130).trim() + '…');
    for (const t of terms) s = s.replace(new RegExp(`(${t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'ig'), '<mark>$1</mark>');
    return s;
  }

  function search(list: Entry[], q: string) {
    const terms = fold(q).split(/\s+/).filter(Boolean);
    if (!terms.length) return [];
    const out: { e: Entry; score: number; hash?: string; heading?: string; line: string }[] = [];
    for (const e of list) {
      const title = fold(e.title), blurb = fold(e.blurb), text = fold(e.text);
      let score = 0, hash: string | undefined, heading: string | undefined;
      let all = true;
      for (const t of terms) {
        let s = 0;
        if (title.includes(t)) s += title.startsWith(t) || title.includes(' ' + t) ? 12 : 8;
        if (blurb.includes(t)) s += 4;
        const h = e.headings.find((h) => fold(h.text).includes(t));
        if (h) { s += 5; hash ??= h.slug; heading ??= h.text; }
        if (text.includes(t)) s += 1 + Math.min(3, text.split(t).length - 1) * 0.5;
        if (!s) { all = false; break; }
        score += s;
      }
      if (!all) continue;
      const line = heading && !title.includes(fold(terms.join(' ')))
        ? `${esc(heading)}`
        : snippet(e.blurb, terms) || snippet(e.text, terms) || esc(e.blurb);
      out.push({ e, score, hash: title.includes(terms[0]) ? undefined : hash, heading, line });
    }
    return out.sort((a, b) => b.score - a.score).slice(0, 8);
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-search]')) {
    const input = root.querySelector('input')!;
    const list = root.querySelector<HTMLUListElement>('.search-results')!;
    const glyphs = new Map<string, string>();
    let active = -1;

    const close = () => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); active = -1; };
    const items = () => [...list.querySelectorAll<HTMLAnchorElement>('a')];
    const mark = (i: number) => {
      const all = items();
      active = all.length ? (i + all.length) % all.length : -1;
      all.forEach((a, j) => a.setAttribute('aria-selected', String(j === active)));
      all[active]?.scrollIntoView({ block: 'nearest' });
    };

    async function render() {
      const q = input.value.trim();
      if (!q) return close();
      const entries = await load();
      if (input.value.trim() !== q) return;
      const hits = search(entries, q);
      list.innerHTML = hits.length
        ? hits.map(({ e, hash, line }) => `<li role="option"><a href="/guides/${e.slug}/${hash ? '#' + hash : ''}">${glyphs.get(e.glyph) ?? ''}<span class="sr-title">${esc(e.title)}</span><span class="sr-line">${line}</span></a></li>`).join('')
        : `<li class="sr-empty">No guides mention “${esc(q)}”. Try a tool name, like Hole or Extrude.</li>`;
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      mark(hits.length ? 0 : -1);
    }

    // Reuse the glyph tiles the page already has, by name, for result rows.
    document.querySelectorAll<HTMLTemplateElement>('template[data-glyph]').forEach((t) => glyphs.set(t.dataset.glyph!, t.innerHTML));

    input.addEventListener('focus', () => { load(); if (input.value.trim()) render(); });
    input.addEventListener('input', render);
    input.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowDown') { ev.preventDefault(); mark(active + 1); }
      else if (ev.key === 'ArrowUp') { ev.preventDefault(); mark(active - 1); }
      else if (ev.key === 'Enter') { const a = items()[active]; if (a) { ev.preventDefault(); location.href = a.href; } }
      else if (ev.key === 'Escape') { if (!list.hidden) close(); else input.blur(); }
    });
    document.addEventListener('click', (ev) => { if (!root.contains(ev.target as Node)) close(); });
  }

  document.addEventListener('keydown', (ev) => {
    const t = ev.target as HTMLElement;
    if (ev.key !== '/' || ev.metaKey || ev.ctrlKey || t.closest('input, textarea, [contenteditable]')) return;
    const input = document.querySelector<HTMLInputElement>('[data-search] input');
    if (input) { ev.preventDefault(); input.focus(); }
  });
</script>
