---
import { guidesByGroup, guideHref } from '../data/guides';
import { GITHUB } from '../data/groups';
const groups = await guidesByGroup();
// Four quiet columns: the two short groups share one.
const pick = (name: string) => groups.find((g) => g.name === name)!;
const cols = [
  { title: 'Start', guides: [...pick('Get Started').guides, ...pick('Discover More').guides] },
  { title: 'Sketch & Model', guides: pick('Sketch & Model').guides },
  { title: 'Select & Change', guides: pick('Select & Change').guides },
  { title: 'Inspect & Print', guides: pick('Inspect & Print').guides },
];
---
<section class="help column">
  <p>Didn’t find what you were looking for?</p>
  <a class="button" href={`${GITHUB}/issues`}>
    Ask on GitHub
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 L11 5 M6 5 H11 V10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</section>
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-inner">
      <div class="footer-cols">
        {cols.map((c) => (
          <nav aria-label={c.title}>
            <h2>{c.title}</h2>
            <ul>{c.guides.map((g) => <li><a href={guideHref(g.id)}>{g.data.short ?? g.data.title}</a></li>)}</ul>
          </nav>
        ))}
      </div>
      <p class="footer-base">
        <img src="/brand/icon-64.png" alt="" width="18" height="18" />
        <span>Fillet · Offline parametric CAD for iPad and Mac · <a href={GITHUB} style="color:inherit">GitHub</a></span>
      </p>
    </div>
  </div>
</footer>
