{
  "start": "new",
  "orientation": "landscape",
  "outDir": "../../../build/docs-shots/patterns",
  "steps": [
    {
      "do": "mcp",
      "tool": "rename_design",
      "arguments": {
        "name": "Flange"
      }
    },
    {
      "do": "mcp",
      "tool": "create_sketch",
      "arguments": {
        "plane": "xy",
        "shapes": [
          {
            "type": "circle",
            "center": [
              0,
              0
            ],
            "diameter": 60
          }
        ]
      }
    },
    {
      "do": "mcp",
      "tool": "extrude",
      "arguments": {
        "sketch": "Sketch 1",
        "distance": 6
      }
    },
    {
      "do": "mcp",
      "tool": "create_sketch",
      "arguments": {
        "plane": "xy",
        "shapes": [
          {
            "type": "circle",
            "center": [
              22,
              0
            ],
            "diameter": 6
          }
        ]
      }
    },
    {
      "do": "mcp",
      "tool": "extrude",
      "arguments": {
        "sketch": "Sketch 2",
        "distance": 6,
        "operation": "cut",
        "targets": "Extrude 1"
      }
    },
    {
      "do": "mcp",
      "tool": "pattern",
      "arguments": {
        "features": [
          "Extrude 2"
        ],
        "layout": "circular",
        "axis": "z",
        "count": 6
      }
    },
    {
      "do": "idle"
    },
    {
      "do": "panel",
      "name": "browser",
      "show": false
    },
    {
      "do": "tap",
      "label": "Step 5, Pattern 1"
    },
    {
      "do": "idle"
    },
    {
      "do": "mcp",
      "tool": "set_view",
      "arguments": {
        "view": "iso"
      }
    },
    {
      "do": "idle"
    },
    {
      "do": "screenshot",
      "path": "circular-full.png"
    }
  ]
}