{
  "start": "new",
  "orientation": "landscape",
  "outDir": "../../../build/docs-shots/patterns",
  "steps": [
    {
      "do": "mcp",
      "tool": "rename_design",
      "arguments": {
        "name": "Pattern Plate"
      }
    },
    {
      "do": "mcp",
      "tool": "create_sketch",
      "arguments": {
        "plane": "xy",
        "shapes": [
          {
            "type": "rectangle",
            "anchor": "corner",
            "position": [
              0,
              0
            ],
            "width": 80,
            "height": 30
          }
        ]
      }
    },
    {
      "do": "mcp",
      "tool": "extrude",
      "arguments": {
        "sketch": "Sketch 1",
        "distance": 10
      }
    },
    {
      "do": "mcp",
      "tool": "create_sketch",
      "arguments": {
        "plane": "xy",
        "shapes": [
          {
            "type": "circle",
            "center": [
              10,
              15
            ],
            "diameter": 8
          }
        ]
      }
    },
    {
      "do": "mcp",
      "tool": "extrude",
      "arguments": {
        "sketch": "Sketch 2",
        "distance": 10,
        "operation": "cut",
        "targets": "Extrude 1"
      }
    },
    {
      "do": "mcp",
      "tool": "pattern",
      "arguments": {
        "features": [
          "Extrude 2"
        ],
        "layout": "linear",
        "axis": "x",
        "count": 4,
        "spacing": 20
      }
    },
    {
      "do": "idle"
    },
    {
      "do": "panel",
      "name": "browser",
      "show": false
    },
    {
      "do": "tap",
      "labelContains": "Pattern 1",
      "type": "button"
    },
    {
      "do": "idle"
    },
    {
      "do": "mcp",
      "tool": "set_view",
      "arguments": {
        "view": "iso"
      }
    },
    {
      "do": "idle"
    },
    {
      "do": "tap",
      "label": "Step 3, Sketch 2"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "screenshot",
      "path": "timeline-refused-full.png",
      "settle": false
    },
    {
      "do": "dump",
      "path": "timeline-refused-tree.txt"
    }
  ]
}