{
  "start": "new",
  "orientation": "landscape",
  "outDir": "../../../build/docs-shots/holes",
  "steps": [
    {"do": "mcp", "tool": "rename_design", "arguments": {"name": "Plate"}},
    {"do": "mcp", "tool": "primitive", "arguments": {"name": "Plate", "kind": "box", "dimensions": {"width": 60, "depth": 30, "height": 12}}},
    {"do": "mcp", "tool": "set_parameter", "arguments": {"name": "clearance", "expression": "0.2 mm", "comment": "Print clearance, added to the diameter of preset screw holes. Tune it once for your printer."}},
    {"do": "idle"},
    {"do": "mcp", "tool": "set_view", "arguments": {"view": "iso", "zoom": 1}},
    {"do": "idle"},
    {"do": "tap", "label": "Hole"},
    {"do": "idle"},
    {"do": "tap", "x": 523, "y": 423},
    {"do": "idle"},
    {"do": "tap", "x": 798, "y": 575},
    {"do": "idle"},
    {"do": "tap", "label": "Preset", "type": "button"},
    {"do": "wait", "seconds": 1},
    {"do": "tap", "label": "Socket head counterbore"},
    {"do": "wait", "seconds": 1},
    {"do": "tap", "label": "M3"},
    {"do": "idle"},
    {"do": "tap", "label": "Through all"},
    {"do": "idle"},
    {"do": "screenshot", "path": "hole-placing.png"},
    {"do": "tap", "label": "Preset", "type": "button"},
    {"do": "wait", "seconds": 1},
    {"do": "tap", "label": "Socket head counterbore"},
    {"do": "wait", "seconds": 1.5},
    {"do": "screenshot", "path": "hole-preset-menu.png", "settle": false},
    {"do": "key", "key": "escape"},
    {"do": "wait", "seconds": 1},
    {"do": "key", "key": "escape"},
    {"do": "wait", "seconds": 1},
    {"do": "drag", "from": {"x": 1200, "y": 800}, "to": {"x": 1200, "y": 400}, "press": 0.05, "velocity": 600, "hold": 0.3},
    {"do": "wait", "seconds": 1},
    {"do": "screenshot", "path": "hole-positions.png"},
    {"do": "tap", "label": "Done"},
    {"do": "idle"},
    {"do": "mcp", "tool": "set_view", "arguments": {"view": "iso", "target": [20, 0, 9], "size": 26}},
    {"do": "idle"},
    {"do": "screenshot", "path": "hole-done.png"}
  ]
}
