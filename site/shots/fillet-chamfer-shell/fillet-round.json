{
 "start": {
  "open": "Rounded plate.fillet"
 },
 "fixture": "fixtures/Rounded plate.fillet",
 "orientation": "landscape",
 "outDir": "../../../build/docs-shots/fillet-chamfer-shell/r2",
 "steps": [
  {
   "do": "mcp",
   "tool": "new_design",
   "arguments": {
    "name": "Rounded plate",
    "replace_current": true
   }
  },
  {
   "do": "mcp",
   "tool": "create_sketch",
   "arguments": {
    "name": "Outline",
    "plane": "xy",
    "shapes": [
     {
      "type": "rectangle",
      "anchor": "corner",
      "position": [
       0,
       0
      ],
      "width": 80,
      "height": 40
     }
    ]
   }
  },
  {
   "do": "mcp",
   "tool": "extrude",
   "arguments": {
    "name": "Plate",
    "sketch": "Outline",
    "distance": 12
   }
  },
  {
   "do": "mcp",
   "tool": "fillet",
   "arguments": {
    "name": "Corners",
    "body": "Plate",
    "edges": {
     "type": "line",
     "parallel_to": [
      0,
      0,
      1
     ]
    },
    "radius": 8
   }
  },
  {
   "do": "idle"
  },
  {
   "do": "panel",
   "name": "browser",
   "show": false
  },
  {
   "do": "wait",
   "seconds": 1
  },
  {
   "do": "mcp",
   "tool": "set_view",
   "arguments": {
    "view": "iso",
    "target": [
     52.8,
     -41.2,
     6
    ],
    "size": 105
   }
  },
  {
   "do": "idle"
  },
  {
   "do": "wait",
   "seconds": 1
  },
  {
   "do": "screenshot",
   "path": "fillet-round-start.png",
   "settle": false
  },
  {
   "do": "wait",
   "seconds": 2.0
  },
  {
   "do": "tap",
   "label": "Fillet"
  },
  {
   "do": "wait",
   "seconds": 1.4
  },
  {
   "do": "tap",
   "x": 664,
   "y": 380
  },
  {
   "do": "wait",
   "seconds": 2.2
  },
  {
   "do": "type",
   "into": {
    "labelContains": "Radius",
    "type": "textField"
   },
   "text": "3",
   "clear": true
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "tap",
   "label": "Hide keyboard"
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "idle"
  },
  {
   "do": "wait",
   "seconds": 1.5
  },
  {
   "do": "screenshot",
   "path": "fillet-round-end.png",
   "settle": false
  },
  {
   "do": "dump",
   "path": "fillet-round.txt"
  },
  {
   "do": "type",
   "into": {
    "labelContains": "Radius",
    "type": "textField"
   },
   "text": "14",
   "clear": true
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "tap",
   "label": "Hide keyboard"
  },
  {
   "do": "wait",
   "seconds": 1.5
  },
  {
   "do": "idle"
  },
  {
   "do": "wait",
   "seconds": 1.0
  },
  {
   "do": "screenshot",
   "path": "fillet-too-big.png"
  },
  {
   "do": "dump",
   "path": "fillet-too-big.txt"
  }
 ]
}