  {
   "do": "wait",
   "seconds": 0.6
  },
  {
   "do": "screenshot",
   "path": "printer-menu.png",
   "settle": false
  },
  {
   "do": "dump",
   "path": "printer-menu-tree.txt"
  }
 ]
