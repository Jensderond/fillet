   "tool": "rename_design",
   "arguments": {
    "name": "Shelf bracket"
   }
  },
  {
   "do": "mcp",
   "tool": "create_sketch",
   "arguments": {
    "name": "Profile",
    "plane": "xz",
    "shapes": [
     {
      "type": "polyline",
      "closed": true,
      "vertices": [
       [
        -25,
        0
       ],
       [
        -15,
        0
       ],
       [
        -15,
        50
       ],
       [
        25,
        50
       ],
       [
        25,
        60
       ],
       [
        -25,
        60
       ]
      ]
     }
    ]
   }
  },
  {
   "do": "mcp",
   "tool": "extrude",
   "arguments": {
    "name": "Bracket",
    "sketch": "Profile",
    "distance": 30,
    "symmetric": true
   }
  },
  {
   "do": "panel",
