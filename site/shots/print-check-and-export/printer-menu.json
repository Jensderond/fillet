   "type": "button"
  },
  {
   "do": "wait",
   "seconds": 2
  },
  {
   "do": "drag",
   "from": {
    "x": 1246,
    "y": 480
   },
   "to": {
    "x": 1246,
    "y": 130
   },
   "press": 0,
   "velocity": 500,
   "hold": 0.4
