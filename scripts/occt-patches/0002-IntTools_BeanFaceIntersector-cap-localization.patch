@@ -1376,6 +1376,15 @@ bool IntTools_BeanFaceIntersector::LocalizeSolutions(
   NCollection_List<IntTools_CurveRangeSample>&   theListCurveRange,
   NCollection_List<IntTools_SurfaceRangeSample>& theListSurfaceRange)
 {
+  // FILLET PATCH: past this many candidates the localisation has degenerated (see Fillet's
+  // scripts/occt-patches); returning false makes ComputeLocalized() fall back to the generic
+  // computation.
+  constexpr int kMaxLocalizedRanges = 256;
+  if (theListCurveRange.Extent() > kMaxLocalizedRanges)
+  {
+    return false;
+  }
+
   int tIt = 0, uIt = 0, vIt = 0;
 
