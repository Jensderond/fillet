@@ -917,12 +922,57 @@ void BRepClass3d_SolidExplorer::InitShape(const TopoDS_Shape& S)
 
   myReject = true; //-- case of infinite solid (without any face)
 
-  TopExp_Explorer Expl;
-  for (Expl.Init(S, TopAbs_FACE); Expl.More(); Expl.Next())
+  // FILLET PATCH: the original builds the intersectors in this loop, one face at a time:
+  //
+  //   for (Expl.Init(S, TopAbs_FACE); Expl.More(); Expl.Next())
+  //   {
+  //     const TopoDS_Face Face = TopoDS::Face(Expl.Current());
+  //     void* ptr = (void*)(new IntCurvesFace_Intersector(Face, Precision::Confusion(), true, false));
+  //     myMapOfInter.Bind(Face, ptr);
+  //     myReject = false; //-- at least one face in the solid
+  //   }
+  //
+  // Here every face's intersector is built on the thread pool first (each depends only on its
+  // face), then they are bound in the same order. A face that occurs twice is bound twice, so the
+  // later intersector wins as before; the one it replaces is deleted instead of leaked. If a face
+  // throws, the faces before it are bound and the first exception (in face order) is rethrown,
+  // as the loop would.
+  std::vector<TopoDS_Face> aFaces;
+  for (TopExp_Explorer Expl(S, TopAbs_FACE); Expl.More(); Expl.Next())
   {
-    const TopoDS_Face Face = TopoDS::Face(Expl.Current());
-    void* ptr = (void*)(new IntCurvesFace_Intersector(Face, Precision::Confusion(), true, false));
-    myMapOfInter.Bind(Face, ptr);
+    aFaces.push_back(TopoDS::Face(Expl.Current()));
+  }
+  const int                          aNbFaces = (int)aFaces.size();
+  std::vector<IntCurvesFace_Intersector*> anInters(aNbFaces, nullptr);
+  std::vector<std::exception_ptr>    aFailures(aNbFaces);
+  OSD_Parallel::For(0, aNbFaces, [&](int i) {
+    try
+    {
+      anInters[i] = new IntCurvesFace_Intersector(aFaces[i], Precision::Confusion(), true, false);
+    }
+    catch (...)
+    {
+      aFailures[i] = std::current_exception();
+    }
+  }, aNbFaces < 2);
+  for (int i = 0; i < aNbFaces; ++i)
+  {
+    if (aFailures[i])
+    {
+      for (int j = i; j < aNbFaces; ++j)
+      {
+        delete anInters[j];
+      }
+      std::rethrow_exception(aFailures[i]);
+    }
+    if (void** aPrev = myMapOfInter.ChangeSeek(aFaces[i]))
+    {
+      if (*aPrev != anInters[i])
+      {
+        delete (IntCurvesFace_Intersector*)*aPrev;
+      }
+    }
+    myMapOfInter.Bind(aFaces[i], (void*)anInters[i]);
     myReject = false; //-- at least one face in the solid
   }
 
